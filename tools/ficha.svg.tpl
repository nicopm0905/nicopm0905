<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 320" width="760" height="320" role="img" aria-labelledby="ficha-title ficha-desc">
  <title id="ficha-title">Ficha técnica de Nicolás Pérez Martín</title>
  <desc id="ficha-desc">Estudiante de Ingeniería del Software en la Universidad de Sevilla y cofundador de Skanda, software de escandallos y márgenes para catering. Viene de trabajar como camarero en caterings. Finalista del Santander X Award 2026. Busca su primer puesto junior en IT o en investigación en IA aplicada.</desc>
  <style>
    {{FONTS}}
    .serif { font-family: 'Ficha Serif', Georgia, 'Times New Roman', serif; }
    .italic { font-family: 'Ficha Serif Italic', Georgia, serif; font-style: italic; }
    .sans { font-family: 'Ficha Sans', 'Segoe UI', Helvetica, Arial, sans-serif; }
    .label { font-family: 'Ficha Sans Bold', 'Segoe UI', Helvetica, Arial, sans-serif; font-weight: 600; font-size: 11px; letter-spacing: 2.2px; fill: {{muted}}; }
    .ink { fill: {{ink}}; }
    .green { fill: {{green}}; }
    .rule { stroke: {{rule}}; stroke-width: 1; }
    .dash { stroke: {{rule}}; stroke-width: 1; stroke-dasharray: 2 4; }
  </style>

  <rect x="1" y="1" width="758" height="318" rx="12" fill="{{paper}}" stroke="{{rule}}" stroke-width="1.5"/>

  <text x="36" y="40" class="label">FICHA TÉCNICA</text>
  <text x="724" y="40" class="label" text-anchor="end">Nº 0905 · SEVILLA / JEREZ</text>
  <line x1="36" y1="54" x2="724" y2="54" class="rule"/>

  <text x="34" y="112" class="serif ink" font-size="48">Nicolás Pérez Martín</text>
  <text x="36" y="148" class="italic green" font-size="21">Hago software para oficios que no se hacen sentado.</text>

  <g transform="rotate(-9 642 116)">
    <circle cx="642" cy="116" r="56" fill="none" stroke="{{green}}" stroke-width="1.6"/>
    <circle cx="642" cy="116" r="49" fill="none" stroke="{{green}}" stroke-width="0.8"/>
    <text x="642" y="99" class="label" text-anchor="middle" style="fill: {{green}}; font-size: 9.5px; letter-spacing: 2.4px;">FINALISTA</text>
    <text x="642" y="122" class="serif green" font-size="18" text-anchor="middle">Santander X</text>
    <text x="642" y="141" class="label" text-anchor="middle" style="fill: {{green}}; font-size: 10px; letter-spacing: 1.6px;">AWARD 2026</text>
  </g>

  <line x1="36" y1="178" x2="724" y2="178" class="dash"/>
  <text x="36" y="204" class="label">PLATO</text>
  <text x="140" y="204" class="sans ink" font-size="16.5">Skanda: escandallos y márgenes reales para catering</text>

  <line x1="36" y1="220" x2="724" y2="220" class="dash"/>
  <text x="36" y="246" class="label">ORIGEN</text>
  <text x="140" y="246" class="sans ink" font-size="16.5">De camarero en caterings a cofundador y desarrollador</text>

  <line x1="36" y1="262" x2="724" y2="262" class="dash"/>
  <text x="36" y="288" class="label">BUSCA</text>
  <text x="140" y="288" class="sans ink" font-size="16.5">Primer puesto junior en IT o en investigación en IA aplicada</text>
</svg>
